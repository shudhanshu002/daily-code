#include <bits/stdc++.h>
using namespace std;

class Solution {
public:
    bool canSplit(vector<int> &nums, int maxSum, int k){
        int count = 1, sum = 0;

        for(int num:nums) {
            if(sum + num > maxSum) {
                count++;
                sum = num;

                if(count > k) return false;
            } else sum += num;
        }
        return true;
    }


    int splitArray(vector<int>& nums, int k) {
        int lo = *max_element(nums.begin(), nums.end());
        int hi = accumulate(nums.begin(), nums.end(), 0);
        int ans = hi;

        while(lo<=hi) {
            int mid = lo + (hi - lo)/2;
            if(canSplit(nums,mid,k)) {
                ans = mid;
                hi = mid-1;
            } else {
                lo = mid + 1;
            }
        }

        return ans;
    }
};